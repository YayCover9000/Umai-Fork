VITE_DEFAULT_PROXY_URL=
VITE_SENTRY_DSN=
VITE_APP_DOMAIN=

# umai-nas (docker-compose): only public values. Never put passwords or client secrets here.
VITE_IMPORT_API_URL=http://umai.home.lan:8787
# Links in shared messages go to people outside the tailnet: keep a publicly reachable Umai here.
VIEWER_BASE_URL=https://umai.noeldemartin.com
# Publish ports only on the Tailscale address of the NAS (tailscale ip -4); default is localhost only.
BIND_ADDR=127.0.0.1
